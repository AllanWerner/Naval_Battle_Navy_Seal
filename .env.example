# ============================================
# BASE DE DONNÉES
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changer_mot_de_passe
POSTGRES_DB=quizdb

# ============================================
# APPLICATION
# ============================================
NODE_ENV=production
PORT=4000

# ============================================
# CONNEXION API -> POSTGRES
# ============================================
# "postgres" est le nom du service dans le compose : c'est le DNS interne
# qui le résout. En développement hors conteneur, voir la section du bas.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=quizdb
DB_USER=postgres
DB_PASSWORD=changer_mot_de_passe
DB_SSL=false

# ============================================
# POULS (tableau de la classe)
# ============================================
TABLEAU_URL=http://tableau.exemple:PORT
GROUPE=NavySeal
COULEUR=#FF0000
SERVICE=api
VERSION=dev
URL_INTERNE=http://localhost:4000
PAVILLON_FICHIER=/data/pavillon.txt

# ============================================
# FRONT
# ============================================
# L'adresse de l'API vue depuis le conteneur du front.
API_URL=http://api:4000

# ============================================
# DÉVELOPPEMENT HORS CONTENEUR
# ============================================
# `npm run db:dev` lance un Postgres jetable sur le port 5433 de l'hôte.
# Décommenter ces trois lignes dans votre .env pour l'utiliser :
# DB_HOST=localhost
# DB_PORT=5433
# API_URL=http://localhost:4000
